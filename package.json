{
  "name": "ev3pad-desktop",
  "productName": "EV3 Direct Control",
  "version": "1.0.0",
  "description": "Kontrol motor LEGO EV3 lewat Bluetooth dengan controller fisik atau controller virtual (versi desktop portable).",
  "main": "electron/main.js",
  "author": "EV3 Direct Control",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:logic": "node tests/logic.test.js",
    "build": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win dir --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:mac": "electron-builder --mac dir"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.ev3pad.desktop",
    "productName": "EV3 Direct Control",
    "copyright": "EV3 Direct Control",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "src/**/*", "package.json"],
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "EV3-Direct-Control-Portable-${version}.${ext}"
    },
    "portable": { "artifactName": "EV3-Direct-Control-Portable-${version}.exe" },
    "linux": { "icon": "build/icon.png", "target": ["AppImage"], "category": "Utility" },
    "mac": { "icon": "build/icon.png", "category": "public.app-category.utilities" }
  }
}
